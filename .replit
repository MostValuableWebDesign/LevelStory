modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[objectStorage]
defaultBucketID = "replit-objstore-ce1220ea-643f-4547-83d1-5f7fe6f94cb5"

[userenv]

[userenv.shared]
LEVELSTORY_HISTORICAL_DATA_DIR = "/home/runner/workspace/artifacts/api-server/.cache"
